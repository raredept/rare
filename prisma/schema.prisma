generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ADMIN is the pre-RBAC role: it keeps every permission until an operator assigns one of the
// two scoped roles (see src/lib/admin-permissions.ts).
enum UserRole {
  ADMIN
  SYSTEM_ADMIN
  SELLER_ADMIN
}

enum OrderStatus {
  pending
  awaiting_payment
  paid
  processing
  shipped
  delivered
  canceled
  refunded
  failed
}

enum PaymentProvider {
  stripe
  mercadopago
  asaas
}

enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionScope {
  ALL_PRODUCTS
  SELECTED_PRODUCTS
  SELECTED_CATEGORIES
}

/// STANDARD: replenishable item (quantity levels apply). UNIQUE: one-of-a-kind piece — one unit
/// is normal, zero after a sale is "sold"; only contradictory numbers are critical
/// (see src/lib/stock-policy.ts).
enum StockPolicy {
  STANDARD
  UNIQUE
}

enum InventoryMovementType {
  reserve
  release
  sale
  adjustment
  manual
}

enum EmailOutboxStatus {
  pending
  sending
  retry
  accepted
  failed
  uncertain
}

model User {
  id                     String                  @id @default(cuid())
  name                   String
  email                  String                  @unique
  username               String?                 @unique
  passwordHash           String
  role                   UserRole                @default(ADMIN)
  active                 Boolean                 @default(true)
  mustChangePassword     Boolean                 @default(false)
  /// Bumped on logout; a session token carrying an older value is rejected.
  sessionVersion         Int                     @default(0)
  /// Active TOTP secret, AES-256-GCM sealed with ADMIN_MFA_ENCRYPTION_KEY (never a hash: the
  /// server must recompute codes). Null until an enrollment is confirmed with a valid code.
  mfaSecretEncrypted     String?
  mfaEnabledAt           DateTime?
  /// Last accepted TOTP time step: a code is accepted once, never replayed.
  mfaLastUsedStep        Int?
  /// Enrollment in progress. Kept apart so an unconfirmed QR never replaces or looks like an active factor.
  mfaPendingSecretEncrypted String?
  mfaPendingCreatedAt    DateTime?
  mfaRecoveryCodes       AdminMfaRecoveryCode[]
  adminPushSubscriptions AdminPushSubscription[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

/// Single-use recovery codes. Only a keyed hash is stored; the code is shown once.
model AdminMfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

/// Sanitized trail of sensitive Admin actions (promotions, MFA). No secrets, no customer PII.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorLabel  String
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

model Customer {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  phone           String?
  cpf             String?
  passwordHash    String
  emailVerifiedAt DateTime?
  active          Boolean           @default(true)
  /// Bumped on logout; a session token carrying an older value is rejected.
  sessionVersion  Int               @default(0)
  /// Asaas customer created for this shopper (reused across checkouts; never taken from the browser).
  asaasCustomerId String?           @unique
  addresses       CustomerAddress[]
  orders          Order[]
  supportRequests SupportRequest[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([active, createdAt])
}

model CustomerAddress {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label         String?
  recipientName String?
  phone         String?
  cep           String
  street        String
  number        String
  complement    String?
  neighborhood  String
  city          String
  state         String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId, isDefault])
}

model Category {
  id                  String     @id @default(cuid())
  name                String
  slug                String     @unique
  parentId            String?
  parent              Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children            Category[] @relation("CategoryHierarchy")
  sortOrder           Int        @default(0)
  active              Boolean    @default(true)
  products            Product[]  @relation("ProductCategory")
  subcategoryProducts Product[]  @relation("ProductSubcategory")
  promotions          PromotionCategory[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([parentId, sortOrder])
  @@index([active, sortOrder])
}

model Product {
  id                    String              @id @default(cuid())
  title                 String
  slug                  String              @unique
  description           String
  shortDescription      String
  brand                 String?
  categoryId            String?
  category              Category?           @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId         String?
  subcategory           Category?           @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  priceInCents          Int
  compareAtPriceInCents Int?
  weightGrams           Int?
  lengthCm              Int?
  widthCm               Int?
  heightCm              Int?
  active                Boolean             @default(true)
  featured              Boolean             @default(false)
  featuredSortOrder     Int?
  sortOrder             Int                 @default(0)
  stockPolicy           StockPolicy         @default(STANDARD)
  images                ProductImage[]
  variants              ProductVariant[]
  orderItems            OrderItem[]
  inventoryMovements    InventoryMovement[]
  promotions            PromotionProduct[]
  supportRequests       SupportRequest[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([active, featured, sortOrder])
  @@index([active, featured, featuredSortOrder])
  @@index([categoryId, active])
  @@index([subcategoryId, active])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  size               String
  sku                String?
  stock              Int                 @default(0)
  reservedStock      Int                 @default(0)
  active             Boolean             @default(true)
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([productId, size])
  @@index([active])
}

model Order {
  id                      String              @id @default(cuid())
  orderNumber             String              @unique
  customerId              String?
  customer                Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName            String?
  customerEmail           String?
  customerPhone           String?
  customerDocument        String?
  customerEmailSnapshot   String?
  customerNameSnapshot    String?
  customerPhoneSnapshot   String?
  customerCpfSnapshot     String?
  shippingAddressSnapshot Json?
  billingAddressSnapshot  Json?
  shippingMethodSnapshot  String?
  shippingCepSnapshot     String?
  shippingQuoteSnapshot   Json?
  cep                     String?
  addressLine1            String?
  addressLine2            String?
  neighborhood            String?
  city                    String?
  state                   String?
  subtotalInCents         Int
  couponCode              String?
  discountInCents         Int                 @default(0)
  /// Sum of automatic promotion discounts already applied to the item prices (subtotal is net of it).
  promotionDiscountInCents Int                @default(0)
  shippingInCents         Int                 @default(0)
  totalInCents            Int
  status                  OrderStatus         @default(pending)
  paymentProvider         PaymentProvider     @default(stripe)
  stripeCheckoutSessionId String?             @unique
  stripePaymentIntentId   String?
  /// Mercado Pago payment id of the Pix created for this order (Checkout API).
  mercadoPagoPaymentId    String?             @unique
  /// Asaas charge (pay_...) created for this order.
  asaasPaymentId          String?             @unique
  /// Provider-hosted page where the shopper pays (Asaas invoice for card). Never a card form of ours.
  paymentUrl              String?
  /// Set once when a refund is requested at the provider, so it is never requested twice.
  refundRequestedAt       DateTime?
  pixCharge               PixCharge?
  paymentMethod           String?
  reservationExpiresAt    DateTime?
  checkoutDeadlineAt      DateTime?
  checkoutExpiredAt       DateTime?
  checkoutExpiryJob       CheckoutExpiryJob?
  paidAt                  DateTime?
  items                   OrderItem[]
  inventoryMovements      InventoryMovement[]
  adminNotifications      AdminNotification[]
  emailOutbox             EmailOutbox[]
  supportRequests         SupportRequest[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([status, paidAt])
  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([customerEmailSnapshot])
  @@index([stripePaymentIntentId])
}

// Payment and enqueue commit together; SMTP runs only after this transaction.
// accepted means SMTP acceptance, never confirmed inbox delivery.
model EmailOutbox {
  id             String            @id @default(cuid())
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind           String            @default("payment_approved")
  recipient      String?
  customerName   String?
  orderNumber    String
  totalInCents   Int
  messageId      String            @unique
  status         EmailOutboxStatus @default(pending)
  attempts       Int               @default(0)
  nextAttemptAt  DateTime          @default(now())
  leaseToken     String?
  leaseExpiresAt DateTime?
  provider       String?
  acceptedAt     DateTime?
  lastErrorCode  String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([orderId, kind])
  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseExpiresAt])
}

// Durable commercial deadline. Provider confirmation precedes stock release.
model CheckoutExpiryJob {
  id                String    @id @default(cuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deadlineAt        DateTime
  nextAttemptAt     DateTime
  status            String    @default("pending")
  attempts          Int       @default(0)
  leaseToken        String?
  leaseExpiresAt    DateTime?
  providerCheckedAt DateTime?
  completedAt       DateTime?
  lastErrorCode     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
}

// Every rendered edit points back to the immutable uploaded original.
model ProductMediaAsset {
  id               String   @id @default(cuid())
  url              String   @unique
  originalUrl      String
  width            Int
  height           Int
  framing          Json?
  createdByAdminId String
  createdAt        DateTime @default(now())
}

model AdminNotification {
  id        String    @id @default(cuid())
  type      String
  title     String
  body      String
  href      String?
  orderId   String?
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([readAt, createdAt])
  @@index([orderId])
}

model AdminPushSubscription {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  endpoint       String    @unique
  p256dh         String
  auth           String
  userAgent      String?
  active         Boolean   @default(true)
  lastNotifiedAt DateTime?
  failedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, active])
  @@index([active, updatedAt])
}

model OrderItem {
  id                   String              @id @default(cuid())
  orderId              String
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitleSnapshot String
  variantId            String?
  variant              ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sizeSnapshot         String
  quantity             Int
  /// Final unit price charged (after the automatic promotion, before order-level coupon).
  unitPriceInCents     Int
  totalInCents         Int
  /// Catalog price at checkout. Null on orders created before promotions existed.
  basePriceInCents     Int?
  /// Snapshot of the promotion applied to this item; readable even if the promotion changes later.
  promotionId          String?
  promotionName        String?
  promotionCode        String?
  promotionDiscountInCents Int               @default(0)
  inventoryMovements   InventoryMovement[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([orderId])
  @@index([orderId, productId])
  @@index([productId])
  @@index([variantId])
  @@index([promotionId])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  type          InventoryMovementType
  productId     String?
  product       Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId     String?
  variant       ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  orderId       String?
  order         Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItemId   String?
  orderItem     OrderItem?            @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  stockDelta    Int                   @default(0)
  reservedDelta Int                   @default(0)
  reason        String?
  createdAt     DateTime              @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
}

model StoreSettings {
  id                           String   @id @default("store")
  storeName                    String   @default("RARE STORE")
  instagramUrl                 String   @default("https://www.instagram.com/rare.deptt/")
  whatsappNumber               String?
  whatsappDefaultMessage       String   @default("Ola, tenho interesse nesse produto da RARE STORE.")
  manualShippingInCents        Int      @default(0)
  freeShippingMinInCents       Int?
  originCep                    String?
  shippingMode                 String   @default("fixed")
  fixedShippingInCents         Int      @default(0)
  freeShippingThresholdInCents Int?
  shippingInstructions         String?
  checkoutRequiresAddress      Boolean  @default(true)
  checkoutReservationMinutes   Int      @default(15)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model OperationalEvidence {
  id                String    @id @default(cuid())
  key               String
  status            String    @default("pending")
  environment       String    @default("staging")
  checkedAt         DateTime?
  checkedByLabel    String?
  notes             String?
  evidenceReference String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([key, environment])
  @@index([status, environment])
  @@index([updatedAt])
}

model HomeBannerSlide {
  id                   String   @id @default(cuid())
  eyebrow              String?
  title                String?
  description          String?
  ctaLabel             String?
  href                 String?
  imageUrl             String   @default("")
  mobileImageUrl       String?
  placement            String   @default("home")
  imageFit             String   @default("cover")
  imagePositionX       Int      @default(50)
  imagePositionY       Int      @default(50)
  mobileImagePositionX Int      @default(50)
  mobileImagePositionY Int      @default(50)
  alt                  String
  active               Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([sortOrder])
  @@index([placement, active, sortOrder])
}

/// What the shopper needs to pay a Pix order again after a reload. Nothing here is a secret:
/// the code only lets someone PAY this exact order.
model PixCharge {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  copyPaste    String
  qrCodeBase64 String?
  ticketUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
  orderId     String?
}

/// Automatic price promotion managed in /admin/promotions. One promotion applies per item (highest
/// priority, then largest discount, then oldest). Effective state is derived from status + dates
/// at read time, so a campaign starts and ends without a deploy or a job.
model Promotion {
  id                   String              @id @default(cuid())
  name                 String
  /// Internal code (unique, url-safe). Snapshot on orders as promotionCode.
  slug                 String              @unique
  status               PromotionStatus     @default(DRAFT)
  type                 PromotionType       @default(PERCENTAGE)
  /// PERCENTAGE: whole percent (1-100). FIXED_AMOUNT: cents. Null only while DRAFT.
  value                Int?
  scope                PromotionScope      @default(SELECTED_PRODUCTS)
  startsAt             DateTime?
  endsAt               DateTime?
  priority             Int                 @default(0)
  homepageFeatured     Boolean             @default(false)
  badgeText            String?
  headline             String?
  subheadline          String?
  ctaLabel             String?
  ctaHref              String?
  bannerImageUrl       String?
  bannerMobileImageUrl String?
  bannerAlt            String?
  createdById          String?
  updatedById          String?
  products             PromotionProduct[]
  categories           PromotionCategory[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status, startsAt, endsAt])
  @@index([homepageFeatured, status])
}

model PromotionProduct {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model PromotionCategory {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
}

/// Asaas webhook deliveries, stored before the 200 answer. The event id is unique, so a redelivery
/// is acknowledged without a second effect. Processing re-reads the payment from the API (the body
/// is only a hint) in the worker or right after the response.
model AsaasWebhookEvent {
  id             String    @id
  event          String
  paymentId      String?
  status         String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  leaseToken     String?
  leaseExpiresAt DateTime?
  processedAt    DateTime?
  lastErrorCode  String?
  receivedAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([paymentId])
  @@index([receivedAt])
}

/// Storefront analytics event. Behavioural rows exist only for visitors who accepted analytics.
/// No IP, no user agent, no customer, name, e-mail, CPF or phone: visitorHash / sessionHash are keyed
/// hashes of random browser ids, and path is a pathname without query string. Checkout, payment and
/// purchase figures are not stored here: the dashboard reads them from the orders.
model SiteAnalyticsEvent {
  id          String   @id @default(cuid())
  /// Allowlisted in src/lib/site-analytics-events.ts.
  type        String
  visitorHash String
  sessionHash String
  path        String
  /// No foreign key: an event outlives a deleted product.
  productId   String?
  /// mobile | tablet | desktop — a coarse class, never the user agent.
  device      String
  createdAt   DateTime @default(now())

  @@index([createdAt, type])
  @@index([type, productId, createdAt])
}

enum SupportCategory {
  PRODUCT_QUESTION
  SOLD_OUT_PRODUCT
  ORDER
  PAYMENT
  SHIPPING
  RETURN
  OTHER
}

enum SupportDeliveryStatus {
  PENDING
  SENT
  FAILED
}

/// Customer support request from /suporte. Persisted BEFORE any e-mail is attempted, so a provider
/// failure never loses a message. `status` tracks the e-mail to the store team, `confirmationStatus`
/// the acknowledgement to the customer; both are delivered with idempotency keys derived from the
/// id (support/<id>/team, support/<id>/customer) and retried by the worker under a lease.
model SupportRequest {
  id                   String                @id @default(cuid())
  /// Public reference shown to the customer (SUP-XXXXXXXX).
  protocol             String                @unique
  /// One-time token of the form render: a double submit returns the same request.
  submissionKey        String                @unique
  customerId           String?
  customer             Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  productId            String?
  product              Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitleSnapshot String?
  productSlugSnapshot  String?
  orderId              String?
  order                Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderNumberSnapshot  String?
  name                 String
  email                String
  category             SupportCategory
  message              String
  status               SupportDeliveryStatus @default(PENDING)
  attempts             Int                   @default(0)
  emailSentAt          DateTime?
  lastErrorCode        String?
  confirmationStatus   SupportDeliveryStatus @default(PENDING)
  confirmationSentAt   DateTime?
  confirmationErrorCode String?
  nextAttemptAt        DateTime              @default(now())
  leaseToken           String?
  leaseExpiresAt       DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([createdAt])
  @@index([status, nextAttemptAt])
  @@index([confirmationStatus, nextAttemptAt])
  @@index([customerId, createdAt])
}
